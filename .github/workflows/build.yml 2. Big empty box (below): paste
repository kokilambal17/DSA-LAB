name: Build exe
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Compile
        shell: bash
        run: |
          for f in *.c; do gcc "$f" -o "${f%.c}.exe"; done
      - uses: actions/upload-artifact@v4
        with:
          name: exe-files
          path: "*.exe"
